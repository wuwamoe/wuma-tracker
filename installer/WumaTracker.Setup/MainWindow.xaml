<Window x:Class="WumaTracker.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="트래커 설치"
        Height="440" Width="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True">
    <Border x:Name="RootBorder" CornerRadius="16" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button x:Name="CloseButton"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Width="46" Height="32"
                        Margin="0,8,8,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        BorderThickness="0"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#22808080" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,-24,0,0">
                    <TextBlock x:Name="StatusText"
                               Text="설치 중..."
                               FontSize="16"
                               FontFamily="Malgun Gothic"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="560"
                               MaxHeight="46"
                               Margin="0,0,0,34" />
                    <Button x:Name="CopyStatusButton"
                            Content="전체 텍스트 복사"
                            FontFamily="Malgun Gothic"
                            FontSize="11"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,4,0,18"
                            Visibility="Collapsed"
                            Click="CopyStatusButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ProgressBar x:Name="Progress"
                                 Width="480" Height="8"
                                 Minimum="0" Maximum="100"
                                 BorderThickness="0"
                                 Margin="0,0,0,36" />
                    <!-- Full wordmark (icon + "트래커" text baked into one
                         asset). Light/dark variants swapped in code-behind
                         (ApplyTheme) — the dark one is white-on-transparent,
                         so it needs the right background to even be
                         visible. Height fixed, width auto via
                         Stretch=Uniform so the asset's own aspect ratio
                         decides the on-screen size. -->
                    <Image x:Name="LogoImage" Height="40" Stretch="Uniform"
                           HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,24,24">
                    <CheckBox x:Name="LaunchAppCheckBox"
                              Content="명조 맵스 트래커 실행"
                              FontFamily="Malgun Gothic"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              Visibility="Collapsed"
                              IsChecked="True" />
                    <Button x:Name="FinishCloseButton"
                            Content="닫기"
                            Width="100" Height="34"
                            FontFamily="Malgun Gothic"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            Click="FinishCloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="FinishBg"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
